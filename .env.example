# Mine Inundation Intelligence System — Environment Configuration Example
# By default, the system operates 100% locally and offline without external API keys.

# Optional: LLM API Keys if hosted models are desired for open-ended queries
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Application Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
CHROMA_DB_PATH=data/chroma_db
SQLITE_DB_PATH=data/extracted/mine_inundation.db
